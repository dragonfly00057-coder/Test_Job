# MatinalJob — configuration locale
NODE_ENV=development
PORT=3000

# Ollama local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000

# PostgreSQL local (Docker Desktop)
POSTGRES_DB=matinaljob
POSTGRES_USER=matinaljob
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://matinaljob:change_this_local_password@127.0.0.1:5432/matinaljob

# Change the local password above before sharing this configuration.
# Never commit the real .env file or production credentials.
